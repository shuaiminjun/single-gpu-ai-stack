{
  "1": { "class_type": "UNETLoader",
         "inputs": { "unet_name": "krea2_turbo_fp8_scaled.safetensors", "weight_dtype": "default" } },
  "2": { "class_type": "CLIPLoader",
         "inputs": { "clip_name": "krea2_text_encoder.safetensors", "type": "krea2" } },
  "3": { "class_type": "VAELoader", "inputs": { "vae_name": "krea2_vae.safetensors" } },
  "4": { "class_type": "CLIPTextEncode",
         "inputs": { "text": "{prompt}", "clip": ["2", 0] } },
  "5": { "class_type": "ConditioningZeroOut", "inputs": { "conditioning": ["4", 0] } },
  "6": { "class_type": "EmptyLatentImage",
         "inputs": { "width": 1024, "height": 1024, "batch_size": 1 } },
  "7": { "class_type": "KSampler",
         "inputs": { "seed": 0, "steps": 8, "cfg": 1.0, "sampler_name": "euler",
                     "scheduler": "simple", "denoise": 1.0,
                     "model": ["1", 0], "positive": ["4", 0], "negative": ["5", 0],
                     "latent_image": ["6", 0] } },
  "8": { "class_type": "VAEDecode", "inputs": { "samples": ["7", 0], "vae": ["3", 0] } },
  "9": { "class_type": "SaveImage",
         "inputs": { "filename_prefix": "stack", "images": ["8", 0] } }
}
